{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@llmops/telemetry": ["./packages/telemetry/src/index.ts"],
      "@llmops/metrics": ["./packages/metrics/src/index.ts"],
      "@llmops/db": ["./packages/db/src/index.ts"],
      "@llmops/opencode-collector": ["./packages/opencode-collector/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
