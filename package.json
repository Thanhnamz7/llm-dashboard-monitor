{
  "name": "llmops-dashboard-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"blue,green\" \"npm run dev -w @llmops/api\" \"npm run dev -w @llmops/web\"",
    "dev:api": "npm run dev -w @llmops/api",
    "dev:web": "npm run dev -w @llmops/web",
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx packages/db/src/seed.ts"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
